#!/usr/bin/env sh

# 运行 commitlint 检查
npx commitlint --edit "$1"
EXIT_CODE=$?

# 如果 commitlint 失败，显示更详细的错误提示
if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "================================================================"
  echo "提交信息不符合规范！"
  echo "================================================================"
  echo ""
  echo "提交信息格式应为："
  echo "   <type>: <subject>"
  echo ""
  echo "   例如：feat: 添加用户登录功能"
  echo ""
  echo "可用的 type 类型（必须在提交信息开头）："
  echo "   - feat     - 新功能"
  echo "   - fix      - 修复 bug"
  echo "   - docs     - 文档变更"
  echo "   - style    - 代码格式（不影响代码运行的变动）"
  echo "   - refactor - 重构（既不是新增功能，也不是修复 bug）"
  echo "   - perf     - 性能优化"
  echo "   - test     - 增加测试"
  echo "   - build    - 构建系统或外部依赖的变更"
  echo "   - ci       - CI 配置文件和脚本的变更"
  echo "   - chore    - 其他修改（比如构建流程、辅助工具变动）"
  echo "   - revert   - 回滚"
  echo ""
  echo "更多示例："
  echo "   feat: 添加用户登录功能"
  echo "   fix: 修复登录页面的验证问题"
  echo "   docs: 更新 README 文档"
  echo "   style: 格式化代码"
  echo ""
  echo "================================================================"
  exit 1
fi