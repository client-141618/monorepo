<view class="page">
  <scroll-view
    class="content with-tabbar-safe-bottom"
    scroll-y
    enable-flex
    lower-threshold="200"
    refresher-enabled
    refresher-triggered="{{refresherTriggered}}"
    bindrefresherrefresh="onRefresherRefresh"
    bindscrolltolower="onScrollToLower"
  >
    <view class="overview-wrap">
      <block wx:for="{{overviewCards}}" wx:for-item="card" wx:key="key">
        <view class="overview-card {{card.className}}">
          <view class="overview-card__label">{{card.label}}</view>
          <view class="overview-card__value">{{card.value}}</view>
        </view>
      </block>
    </view>

    <view class="section-title">预定信息</view>

    <view wx:if="{{loading}}" class="loading-wrap">
      <van-loading size="24px" type="spinner" color="#1989fa" />
    </view>

    <view wx:elif="{{reservationList.length}}" class="reservation-list">
      <block wx:for="{{reservationList}}" wx:for-item="reservation" wx:key="id">
        <view class="reservation-card">
          <view class="status-tag {{reservation.statusClass}}">{{reservation.statusText}}</view>
          <view class="reservation-card__title">{{reservation.title}}</view>

          <block wx:for="{{reservation.detailLines}}" wx:for-item="line" wx:key="key">
            <view class="reservation-card__line">
              <text class="reservation-card__key">{{line.label}}</text>
              <text class="reservation-card__value {{line.valueClassName || ''}}">{{line.value}}</text>
            </view>
          </block>

          <view wx:if="{{reservation.status === 1}}" class="reservation-card__actions">
            <van-button
              plain
              size="small"
              block
              custom-class="reservation-card__cancel-btn"
              loading="{{cancelLoadingId === reservation.id}}"
              disabled="{{checkInLoadingId > 0 || cancelLoadingId > 0}}"
              data-reservation-id="{{reservation.id}}"
              bindtap="onTapCancelReservation"
            >
              取消预约
            </van-button>
            <van-button
              type="primary"
              size="small"
              block
              custom-class="reservation-card__checkin-btn"
              loading="{{checkInLoadingId === reservation.id}}"
              disabled="{{checkInLoadingId > 0 || cancelLoadingId > 0}}"
              data-reservation-id="{{reservation.id}}"
              bindtap="onTapCheckIn"
            >
              去签到
            </van-button>
          </view>
        </view>
      </block>
      <view wx:if="{{loadingMore}}" class="load-more">加载中...</view>
      <view wx:elif="{{noMore}}" class="load-more load-more--end">已经到底了</view>
    </view>

    <view wx:else class="empty-wrap">
      <view wx:if="{{errorText}}" class="error-tip">{{errorText}}</view>
      <van-empty description="暂无预定记录" />
    </view>
  </scroll-view>
</view>
