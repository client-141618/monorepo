<view class="page">
  <navigation-bar
    title="通知消息"
    background="#f7f8fa"
    color="#111827"
    back="{{false}}"
    home-button="{{false}}"
  />

  <scroll-view class="content with-tabbar-safe-bottom" scroll-y>
    <view wx:if="{{loading}}" class="loading-wrap">
      <van-loading size="24px" type="spinner" color="#1989fa" />
    </view>

    <view wx:elif="{{list.length}}" class="message-list">
      <block wx:for="{{list}}" wx:key="id">
        <view class="message-item" data-id="{{item.id}}" bindtap="onTapItem">
          <text class="message-item__type message-item__type--{{item.type}}">
            {{item.typeLabel}}
          </text>
          <view class="message-item__title">{{item.title}}</view>
          <view class="message-item__summary-row">
            <text class="message-item__summary">{{item.summary}}</text>
            <text class="message-item__arrow">›</text>
          </view>
        </view>
      </block>
    </view>

    <view wx:else class="empty-wrap">
      <van-empty description="暂无通知消息" />
    </view>
  </scroll-view>
</view>
