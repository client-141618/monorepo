<view class="page">
  <navigation-bar
    title="通知详情"
    background="#f7f8fa"
    color="#111827"
    back="{{true}}"
    bind:back="onBack"
  />

  <scroll-view class="content" scroll-y>
    <view wx:if="{{loading}}" class="loading-wrap">
      <van-loading size="24px" type="spinner" color="#1989fa" />
    </view>

    <view wx:elif="{{detail}}" class="detail-wrap">
      <view class="detail-hero-card">
        <view class="detail-type">{{typeLabel}}</view>
        <view class="detail-title">{{detail.title}}</view>
      </view>

      <view class="detail-summary-card">
        <view class="detail-label">摘要</view>
        <view class="detail-summary">{{detail.summary}}</view>
      </view>

      <view class="detail-content-card">
        <view class="detail-label">正文</view>
        <rich-text class="detail-content" nodes="{{safeContent}}" />
      </view>
    </view>

    <view wx:else class="empty-wrap">
      <van-empty description="通知不存在或无权限查看" />
    </view>
  </scroll-view>
</view>
